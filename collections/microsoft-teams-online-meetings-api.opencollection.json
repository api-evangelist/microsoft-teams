{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Graph Teams Apps Online Meetings API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
      "accessTokenUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Online Meetings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Microsoft Teams Create Online Meeting",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://graph.microsoft.com/v1.0/communications/onlineMeetings",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new online meeting."
        },
        {
          "info": {
            "name": "Microsoft Teams Get Online Meeting",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://graph.microsoft.com/v1.0/communications/onlineMeetings/:meeting-id",
            "params": [
              {
                "name": "meeting-id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the meeting."
              }
            ]
          },
          "docs": "Retrieve details of an online meeting."
        }
      ]
    }
  ],
  "bundled": true
}